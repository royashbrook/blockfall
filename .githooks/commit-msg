#!/bin/sh
# Every commit must reference a GitHub issue (e.g. "#12").
# Issues: https://github.com/royashbrook/blockfall/issues
msg_file="$1"
if ! grep -qE '#[0-9]+' "$msg_file"; then
    echo "✗ commit rejected: the message must reference an issue, e.g. '#12'." >&2
    echo "  Issues: https://github.com/royashbrook/blockfall/issues" >&2
    exit 1
fi
exit 0
