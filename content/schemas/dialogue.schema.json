{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blockfall:dialogue",
  "title": "Dialogue tree (NPC)",
  "type": "object",
  "additionalProperties": false,
  "required": ["npc_id", "name", "nodes"],
  "properties": {
    "npc_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "name": { "type": "string", "maxLength": 32 },
    "root": { "type": "integer", "default": 0, "description": "starting node id" },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "maxLength": 240 },
          "gives_quest": { "type": "integer", "description": "quest id offered here" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["label", "goto"],
              "properties": {
                "label": { "type": "string", "maxLength": 64 },
                "goto": { "type": "integer", "description": "next node id; -1 ends" }
              }
            }
          }
        }
      }
    }
  }
}
