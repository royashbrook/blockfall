{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blockfall:loot",
  "title": "Loot table",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rolls", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "rolls": { "type": "integer", "minimum": 1, "maximum": 16,
               "description": "number of weighted draws" },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "weight"],
        "properties": {
          "item": { "type": "string", "description": "item name, or \"nothing\"" },
          "weight": { "type": "integer", "minimum": 1 },
          "min": { "type": "integer", "minimum": 0, "default": 1 },
          "max": { "type": "integer", "minimum": 1, "default": 1 }
        }
      }
    }
  }
}
